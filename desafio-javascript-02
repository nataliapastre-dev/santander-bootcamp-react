/*
=========================================
Desafio 02 - Boas-vindas Bankly
Santander Bootcamp React
=========================================

Descrição:
Receber o nome do usuário e o saldo da conta em centavos.
Exibir uma mensagem de boas-vindas com o saldo formatado
em reais, utilizando duas casas decimais e vírgula como
separador decimal.
*/

const entrada = gets();

const [nome, saldoCentavos] = entrada.split(" ");

const saldoReais = (Number(saldoCentavos) / 100)
  .toFixed(2)
  .replace(".", ",");

print(`Bem-vindo, ${nome}! Seu saldo é R$${saldoReais}`);
